<?wdn include "pages/_layout_top.wdn"; ?>
<h1>Guestbook</h1>
<?wdn if (current_user() !== null): ?>
<form method="post" action="/post">
  <?= csrf_field() ?>
  <textarea name="body" maxlength="1000" required></textarea>
  <button>Sign</button>
</form>
<?wdn endif; ?>
<ul>
<?wdn foreach (db_query("SELECT author, body FROM messages ORDER BY id DESC LIMIT 50") as $m): ?>
  <li><strong><?= $m["author"] ?></strong>: <?= nl2br($m["body"]) ?></li>
<?wdn endforeach; ?>
</ul>
</body></html>
